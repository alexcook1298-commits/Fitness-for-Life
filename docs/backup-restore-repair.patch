 function frictionAdvice(r){return ({Time:'Use Adaptive Session or COMPACT/MED before creating make-up debt.',Work:'Move optional work first; protect the two anchor lifting sessions.',School:'Use SURVIVAL mode during academic crunch weeks and protect training floors.',Equipment:'Use Gym Profiles and preserve slot purpose with substitutions.',Travel:'Create a travel equipment profile and run minimum useful sessions.',Motivation:'Reduce activation energy: start with the first anchor movement or a 10-minute floor.', 'Sleep / fatigue':'Keep architecture stable; lower optional intensity and reassess repeated patterns.', 'Joint discomfort':'Do not push through sharp or unusual pain. Substitute or stop the affected movement and reassess.'})[r]||'Look for a repeated constraint before changing the program.'}
