+// Logged exposure per bar. Sets and checklist items are different units and are reported side by side, never converted or summed.
+function budgetExposure(){
+ const out={};Object.keys(budgetData()).forEach(k=>{out[k]={sessions:0,full:0,partial:0,none:0,notRecorded:0,setsLogged:0,itemsTicked:0}});
+ recentSessions(7).forEach(x=>{const c=completionOf(x);budgetCategories(x.template).forEach(cat=>{
+  const e=out[cat];e.sessions++;
+  if(c.prescription==='unknown'){e.notRecorded++;return}
+  e[c.prescription]++;if(c.basis==='items')e.itemsTicked+=c.performed;else e.setsLogged+=c.performed;
+ })});
+ return out;
+}
+function budgetExposureLines(){
+ const ex=budgetExposure(),rows=Object.entries(ex).filter(([,e])=>e.sessions).map(([k,e])=>`${k}: ${e.sessions} session${e.sessions===1?'':'s'} (${e.full} full, ${e.partial} partial, ${e.none} none, ${e.notRecorded} not recorded)${e.setsLogged?`; ${e.setsLogged} sets logged`:''}${e.itemsTicked?`; ${e.itemsTicked} checklist items ticked`:''}`);
+ return rows.length?'\n\nLOGGED EXPOSURE (last 7 days)\n'+rows.join('\n'):'';
+}
+function budgetExposureText(e){
+ if(!e.sessions)return '';
