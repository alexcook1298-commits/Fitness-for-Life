+const READINESS_STALE_HOURS=48;
+function readinessFreshness(r,now=Date.now()){
+ const t=r&&r.date!=null&&r.date!==''?new Date(r.date).getTime():NaN;
+ if(!Number.isFinite(t))return {state:'never',hours:null,days:null};
+ const hours=(now-t)/3600000;
+ if(hours<-5/60)return {state:'future',hours,days:null};
+ return {state:hours>READINESS_STALE_HOURS?'stale':'fresh',hours,days:Math.floor(Math.max(0,hours)/24)};
+}
+function readinessStatus(r,now=Date.now()){
+ r=r||{};const dec=readinessDecision(r),f=readinessFreshness(r,now),score=readinessScore(r);
+ if(f.state==='fresh')return {...dec,fresh:f,stale:false,scoreText:`Check-in ${score} / 100`};
+ const ago=f.days===1?'1 day ago':f.days+' days ago';
+ const age=f.state==='never'?'No check-in has been saved yet':f.state==='future'?'The saved check-in is dated in the future (device clock or time zone changed?)':`Last check-in was ${ago}`;
+ const scoreText=f.state==='never'?'No check-in saved':f.state==='future'?'Saved check-in date is not usable':`Last check-in ${ago} • ${score} / 100`;
+ if(dec.jointOverride)return {...dec,stale:true,fresh:f,scoreText,text:`${age}. The saved joint flag still applies until you update the check-in. ${dec.text}`};
+ return {label:f.state==='never'?'NOT CHECKED IN':'STALE CHECK-IN',cls:f.state==='never'?'status-gray':'status-yellow',text:`${age}. Update your check-in before relying on this status. Nothing in the plan has changed.`,stale:true,fresh:f,scoreText,jointOverride:false,basedOn:dec.label};
+}
