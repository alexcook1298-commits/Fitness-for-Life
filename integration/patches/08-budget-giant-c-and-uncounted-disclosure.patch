+// Practical Capability Training) is deliberately unclassified and is disclosed as "not counted" instead of being forced into a bar.
+function budgetCategories(template){
+ const t=String(template);
+ if(/^(a|b[2-7]a)$/.test(t))return ['Strength'];
+ if(/^(b|bu|bl|b[2-7]b|b3c|bonusarms|bonusback)$/.test(t))return ['Hypertrophy'];
